{
  "name": "colors",
  "version": "1.0.0",
  "private": true,
  "description": "COP 4331 COLORS LAMP web application. Node is used only for linting tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex-Kemper/colors.git"
  },
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:js": "eslint public/js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1"
  }
}
